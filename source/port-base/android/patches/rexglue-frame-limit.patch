+    // Pace the actual guest output producer, independently of host vsync and
+    // FPS statistics. Slow frames never wait; a stall starts a new interval
+    // rather than producing a burst of catch-up frames. No UI lock is held.
+    const int32_t frame_limit = REXCVAR_GET(guest_frame_limit);
+    if (frame_limit > 0) {
+      const auto period = std::chrono::nanoseconds((1000000000LL + frame_limit - 1) / frame_limit);
+      if (guest_output_last_paced_.time_since_epoch().count()) {
+        std::this_thread::sleep_until(guest_output_last_paced_ + period);
+      }
+      guest_output_last_paced_ = std::chrono::steady_clock::now();
+    } else {
+      guest_output_last_paced_ = {};
