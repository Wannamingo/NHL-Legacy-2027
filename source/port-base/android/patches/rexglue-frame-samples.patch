+std::vector<uint64_t> Presenter::GetGuestFrameTimestampsMicroseconds() const {
+  std::lock_guard<std::mutex> stats_lock(guest_frame_stats_mutex_);
+  std::vector<uint64_t> times;
+  times.reserve(guest_frame_timestamp_count_);
+  for (size_t i = 0; i < guest_frame_timestamp_count_; ++i) {
+    size_t index = (guest_frame_timestamp_next_ + kGuestFrameTimestampCount -
+                    guest_frame_timestamp_count_ + i) % kGuestFrameTimestampCount;
+    times.push_back(std::chrono::duration_cast<std::chrono::microseconds>(
+        guest_frame_timestamps_[index].time_since_epoch()).count());
+  }
