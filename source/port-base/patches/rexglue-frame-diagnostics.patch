+std::atomic<bool> enabled{false};
+std::atomic<int> render_tid{0};
+std::array<std::atomic<uint64_t>, size_t(Wait::kCount)> total_ns{}, total_calls{};
+}
+void SetEnabled(bool value) { enabled.store(value, std::memory_order_relaxed); }
+bool Enabled() { return enabled.load(std::memory_order_relaxed); }
+void SetRenderThreadId(int tid) { render_tid.store(tid, std::memory_order_relaxed); }
+int RenderThreadId() { return render_tid.load(std::memory_order_relaxed); }
+void AddWait(Wait kind, uint64_t ns) {
+  const size_t i = size_t(kind);
+  total_ns[i].fetch_add(ns, std::memory_order_relaxed);
+  total_calls[i].fetch_add(1, std::memory_order_relaxed);
+}
+Totals ReadTotals() {
+  Totals result;
+  for (size_t i = 0; i < size_t(Wait::kCount); ++i) {
+    result.nanoseconds[i] = total_ns[i].load(std::memory_order_relaxed);
+    result.calls[i] = total_calls[i].load(std::memory_order_relaxed);
+  }
+  return result;
+}
