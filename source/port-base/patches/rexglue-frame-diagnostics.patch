--- /dev/null
+++ b/include/rex/ui/frame_diagnostics.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::ui::diagnostics {
+enum class Wait : size_t {
+  kAcquire, kPresentCall, kRetire, kFrameCap, kQueueLock,
+  kRenderQueueLock, kRenderSubmit, kCount
+};
+struct Totals {
+  std::array<uint64_t, size_t(Wait::kCount)> nanoseconds{}, calls{};
+};
+// Cumulative counters: no resets while a measured operation is in flight.
+void SetEnabled(bool enabled);
+bool Enabled();
+Totals ReadTotals();
+void AddWait(Wait kind, uint64_t nanoseconds);
+void SetRenderThreadId(int tid);
+int RenderThreadId();
+class WaitTimer {
+ public:
+  explicit WaitTimer(Wait kind) : kind_(kind), enabled_(Enabled()) {
+    if (enabled_) start_ = std::chrono::steady_clock::now();
+  }
+  ~WaitTimer() {
+    if (enabled_) AddWait(kind_, uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start_).count()));
+  }
+  WaitTimer(const WaitTimer&) = delete;
+  WaitTimer& operator=(const WaitTimer&) = delete;
+ private:
+  Wait kind_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_{};
+};
+}  // namespace rex::ui::diagnostics
