+bool Memory::WriteWatchCallbackThunk(
+    std::unique_lock<std::recursive_mutex> global_lock_locked_once, void* context,
+    void* host_address, bool is_write) {
+  auto* memory = reinterpret_cast<Memory*>(context);
+  if (!is_write ||
+      reinterpret_cast<uintptr_t>(host_address) < reinterpret_cast<uintptr_t>(memory->virtual_membase_) ||
+      reinterpret_cast<uintptr_t>(host_address) >= reinterpret_cast<uintptr_t>(memory->physical_membase_)) {
+    return false;
+  }
+  return memory->TriggerPhysicalMemoryCallbacks(
+      std::move(global_lock_locked_once), memory->HostToGuestVirtual(host_address), 1,
+      true, false);
+}
