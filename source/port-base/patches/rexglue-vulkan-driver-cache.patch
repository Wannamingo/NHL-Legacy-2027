@@ -0,0 +1,167 @@
+#pragma once
+
+#include <rex/hash.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/device.h>
+#include <atomic>
+#include <mutex>
+#include <fmt/format.h>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <shared_mutex>
+#include <thread>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+// Device-specific driver binaries complement the portable Xenos shader/PSO
+// descriptions. Cache creation uses internal Vulkan synchronization; a shared
+// lock permits parallel compilation while snapshots/destruction are exclusive.
+class DriverPipelineCache {
+ public:
+  DriverPipelineCache(const ui::vulkan::VulkanDevice& device,
+                      const std::filesystem::path& root, uint32_t title_id)
+      : device_(device) {
+    device_.vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        device_.physical_device(), &properties_);
+    std::error_code error;
+    std::filesystem::create_directories(root, error);
+    if (error) return;
+    path_ = root / fmt::format("{:08X}-{:04X}-{:04X}-{:08X}-v1.vkc", title_id,
+        properties_.vendorID, properties_.deviceID, properties_.driverVersion);
+    auto data = Read();
+    VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+    info.initialDataSize = data.size();
+    info.pInitialData = data.empty() ? nullptr : data.data();
+    auto result = device_.functions().vkCreatePipelineCache(device_.device(), &info, nullptr, &cache_);
+    if (result != VK_SUCCESS && !data.empty()) {
+      info.initialDataSize = 0; info.pInitialData = nullptr;
+      data.clear();
+      result = device_.functions().vkCreatePipelineCache(device_.device(), &info, nullptr, &cache_);
+    }
+    if (result != VK_SUCCESS) {
+      cache_ = VK_NULL_HANDLE;
+      REXGPU_WARN("Vulkan driver cache unavailable (result={})", int32_t(result));
+    } else {
+      REXGPU_INFO("Vulkan driver cache loaded: {} bytes, {}", data.size(), path_.string());
+    }
+  }
+  ~DriverPipelineCache() {
+    {
+      std::lock_guard<std::mutex> lock(worker_mutex_);
+      stop_ = true;
+    }
+    worker_condition_.notify_one();
+    if (worker_.joinable()) worker_.join();
+    Save();
+    std::unique_lock<std::shared_mutex> lock(cache_mutex_);
+    if (cache_ != VK_NULL_HANDLE)
+      device_.functions().vkDestroyPipelineCache(device_.device(), cache_, nullptr);
+  }
+  void StartSaving() {
+    Save(); // Startup preload is saved before the guest starts.
+    if (cache_ == VK_NULL_HANDLE || worker_.joinable()) return;
+    worker_ = std::thread([this] {
+      std::unique_lock<std::mutex> lock(worker_mutex_);
+      while (!stop_) {
+        worker_condition_.wait_for(lock, std::chrono::seconds(5), [this] { return stop_; });
+        if (stop_) break;
+        lock.unlock(); Save(); lock.lock();
+      }
+    });
+  }
+  VkResult Create(const VkGraphicsPipelineCreateInfo& info, VkPipeline& pipeline) {
+    std::shared_lock<std::shared_mutex> lock(cache_mutex_);
+    auto result = device_.functions().vkCreateGraphicsPipelines(
+        device_.device(), cache_, 1, &info, nullptr, &pipeline);
+    if (result == VK_SUCCESS && cache_ != VK_NULL_HANDLE) revision_.fetch_add(1);
+    return result;
+  }
+
+  VkResult Create(const VkComputePipelineCreateInfo& info, VkPipeline& pipeline) {
+    std::shared_lock<std::shared_mutex> lock(cache_mutex_);
+    auto result = device_.functions().vkCreateComputePipelines(
+        device_.device(), cache_, 1, &info, nullptr, &pipeline);
+    if (result == VK_SUCCESS && cache_ != VK_NULL_HANDLE) revision_.fetch_add(1);
+    return result;
+  }
+
+ private:
+  struct Header {
+    uint32_t magic = 0x434B564E, version = 1, driver = 0, size = 0;
+    uint64_t hash = 0;
+  };
+  static constexpr size_t kMaxBytes = 128 * 1024 * 1024;
+  std::vector<uint8_t> Read() {
+    std::ifstream input(path_, std::ios::binary | std::ios::ate);
+    if (!input) return {};
+    const auto bytes = input.tellg();
+    if (bytes < std::streamoff(sizeof(Header) + sizeof(VkPipelineCacheHeaderVersionOne)) ||
+        bytes > std::streamoff(sizeof(Header) + kMaxBytes)) return {};
+    input.seekg(0);
+    Header header;
+    input.read(reinterpret_cast<char*>(&header), sizeof(header));
+    if (!input || header.magic != 0x434B564E || header.version != 1 ||
+        header.driver != properties_.driverVersion || header.size > kMaxBytes ||
+        bytes != std::streamoff(sizeof(Header) + header.size)) return {};
+    std::vector<uint8_t> data(header.size);
+    input.read(reinterpret_cast<char*>(data.data()), data.size());
+    if (!input || XXH3_64bits(data.data(), data.size()) != header.hash) return {};
+    VkPipelineCacheHeaderVersionOne cache_header;
+    std::memcpy(&cache_header, data.data(), sizeof(cache_header));
+    if (cache_header.headerSize < sizeof(cache_header) || cache_header.headerSize > data.size() ||
+        cache_header.headerVersion != VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
+        cache_header.vendorID != properties_.vendorID || cache_header.deviceID != properties_.deviceID ||
+        std::memcmp(cache_header.pipelineCacheUUID, properties_.pipelineCacheUUID, VK_UUID_SIZE)) return {};
+    return data;
+  }
+  void Save() {
+    std::lock_guard<std::mutex> saving(save_mutex_);
+    if (cache_ == VK_NULL_HANDLE || path_.empty() || revision_.load() == saved_revision_) return;
+    size_t size = 0;
+    std::vector<uint8_t> data;
+    uint64_t revision;
+    {
+      std::unique_lock<std::shared_mutex> lock(cache_mutex_);
+      revision = revision_.load();
+      if (device_.functions().vkGetPipelineCacheData(device_.device(), cache_, &size, nullptr) != VK_SUCCESS ||
+          size < sizeof(VkPipelineCacheHeaderVersionOne) || size > kMaxBytes) return;
+      data.resize(size);
+      if (device_.functions().vkGetPipelineCacheData(device_.device(), cache_, &size, data.data()) != VK_SUCCESS)
+        return;
+    }
+    data.resize(size);
+    Header header;
+    header.driver = properties_.driverVersion; header.size = uint32_t(size);
+    header.hash = XXH3_64bits(data.data(), data.size());
+    auto pending = path_; pending += ".pending";
+    {
+      std::ofstream output(pending, std::ios::binary | std::ios::trunc);
+      output.write(reinterpret_cast<const char*>(&header), sizeof(header));
+      output.write(reinterpret_cast<const char*>(data.data()), data.size());
+      output.flush();
+      if (!output) return;
+    }
+    std::error_code error;
+    std::filesystem::rename(pending, path_, error);
+    if (error) return;
+    saved_revision_ = revision;
+    REXGPU_INFO("Vulkan driver cache saved: {} bytes, {}", size, path_.string());
+  }
+  const ui::vulkan::VulkanDevice& device_;
+  VkPhysicalDeviceProperties properties_{};
+  VkPipelineCache cache_ = VK_NULL_HANDLE;
+  std::filesystem::path path_;
+  std::shared_mutex cache_mutex_;
+  std::mutex save_mutex_, worker_mutex_;
+  std::condition_variable worker_condition_;
+  std::thread worker_;
+  bool stop_ = false;
+  std::atomic<uint64_t> revision_{0};
+  uint64_t saved_revision_ = 0;
+};
+} // namespace rex::graphics::vulkan
