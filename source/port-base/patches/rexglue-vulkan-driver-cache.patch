+#pragma once
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+
+namespace rex::graphics::vulkan {
+// Optional Android startup indicator. Updates occur only during preload, in
+// batches, and use atomic replacement so the UI never reads a partial record.
+class ShaderStartupProgress {
+ public:
+  ShaderStartupProgress() {
+    if (const char* path = std::getenv("NHL_SHADER_PROGRESS")) path_ = path;
+    Write("preparing");
+  }
+  ~ShaderStartupProgress() { Write("ready"); }
+  void SetTotal(size_t total) { total_ = total; Write("preparing"); }
+  void Advance() {
+    if (path_.empty()) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++completed_;
+    if (completed_ % 8 == 0 || completed_ == total_) Write("preparing");
+  }
+ private:
+  void Write(const char* stage) {
+    if (path_.empty()) return;
+    auto temporary = path_; temporary += ".pending";
+    {
+      std::ofstream stream(temporary, std::ios::trunc);
+      stream << stage << ' ' << completed_ << ' ' << total_ << '\n';
+      if (!stream) return;
+    }
+    std::error_code error;
+    std::filesystem::rename(temporary, path_, error);
+  }
+  std::filesystem::path path_;
+  std::mutex mutex_;
+  size_t completed_ = 0, total_ = 0;
+};
+} // namespace rex::graphics::vulkan
