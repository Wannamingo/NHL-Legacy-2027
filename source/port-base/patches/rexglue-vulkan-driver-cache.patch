+void VulkanCommandProcessor::InitializeDriverPipelineCache(const std::filesystem::path& root,
+                                                           uint32_t title_id) {
+  // A cache belongs to this Vulkan device and remains valid throughout shader
+  // storage reloads. Built-in pipelines must use it before guest preloading.
+  if (driver_pipeline_cache_ || root.empty()) return;
+  driver_pipeline_cache_ = std::make_unique<DriverPipelineCache>(*GetVulkanDevice(), root, title_id);
+  driver_pipeline_cache_->StartSaving();
+}
+
+void VulkanCommandProcessor::SaveDriverPipelineCache() {
+  if (driver_pipeline_cache_) driver_pipeline_cache_->StartSaving();
+}
+
+VkResult VulkanCommandProcessor::CreateCachedGraphicsPipeline(
+    const VkGraphicsPipelineCreateInfo& info, VkPipeline& out) {
+  if (driver_pipeline_cache_) return driver_pipeline_cache_->Create(info, out);
+  return GetVulkanDevice()->functions().vkCreateGraphicsPipelines(
+      GetVulkanDevice()->device(), VK_NULL_HANDLE, 1, &info, nullptr, &out);
+}
+
+VkPipeline VulkanCommandProcessor::CreateCachedComputePipeline(VkPipelineLayout layout,
+    VkShaderModule shader, const VkSpecializationInfo* specialization, const char* entry_point) {
+  VkComputePipelineCreateInfo info{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+  info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  info.stage.module = shader;
+  info.stage.pName = entry_point;
+  info.stage.pSpecializationInfo = specialization;
+  info.layout = layout;
+  info.basePipelineIndex = -1;
+  VkPipeline out = VK_NULL_HANDLE;
+  const auto result = driver_pipeline_cache_ ? driver_pipeline_cache_->Create(info, out)
+      : GetVulkanDevice()->functions().vkCreateComputePipelines(
+          GetVulkanDevice()->device(), VK_NULL_HANDLE, 1, &info, nullptr, &out);
+  return result == VK_SUCCESS ? out : VK_NULL_HANDLE;
+}
+
+VkPipeline VulkanCommandProcessor::CreateCachedComputePipeline(VkPipelineLayout layout,
+    const uint32_t* shader_code, size_t size_bytes,
+    const VkSpecializationInfo* specialization, const char* entry_point) {
+  const VkShaderModule shader = ui::vulkan::util::CreateShaderModule(
+      GetVulkanDevice(), shader_code, size_bytes);
+  if (shader == VK_NULL_HANDLE) return VK_NULL_HANDLE;
+  const VkPipeline out = CreateCachedComputePipeline(layout, shader, specialization, entry_point);
+  GetVulkanDevice()->functions().vkDestroyShaderModule(GetVulkanDevice()->device(), shader, nullptr);
+  return out;
+}
